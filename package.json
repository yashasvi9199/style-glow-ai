{
  "name": "style-glow-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://yashasvi9199.github.io/style-glow-ai",
  "scripts": {
    "dev": "vite",
    "dev:wrangler": "npm run build && wrangler pages dev --compatibility-date=2026-08-01 dist",
    "build": "node_modules/typescript/bin/tsc && node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "predeploy": "VITE_GITHUB_PAGES=true npm run build",
    "deploy": "gh-pages -d dist",
    "cap:add": "cap add android",
    "cap:sync": "cap sync",
    "cap:open": "cap open android",
    "android": "npm run build && npx cap sync && cd android && ./gradlew assembleRelease --info",
    "android-debug": "npm run build && npx cap sync && cd android && ./gradlew assembleDebug --info",
    "adb-install": "adb devices && cd android/app/build/outputs/apk/release/ && adb install app-release.apk",
    "adb-install-debug": "adb devices && cd android/app/build/outputs/apk/debug/ && adb install app-debug.apk"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/core": "^6.0.0",
    "@google/genai": "^1.30.0",
    "@google/generative-ai": "^0.24.1",
    "better-auth": "^1.6.25",
    "clsx": "^2.1.0",
    "kysely": "^0.29.4",
    "kysely-d1": "^0.4.0",
    "lucide-react": "^0.344.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.18.1",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.18",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.4",
    "wrangler": "^3.60.0"
  }
}
